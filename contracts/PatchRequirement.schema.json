{
  "$defs": {
    "Answer": {
      "additionalProperties": false,
      "properties": {
        "clarification_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Clarification Id",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "clarification_id",
        "value"
      ],
      "title": "Answer",
      "type": "object"
    },
    "Edit": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "add",
            "replace",
            "remove",
            "reorder"
          ],
          "title": "Op",
          "type": "string"
        },
        "target": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "required": [
        "op",
        "target"
      ],
      "title": "Edit",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "text": {
      "anyOf": [
        {
          "maxLength": 8000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text"
    },
    "edits": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Edit"
          },
          "maxItems": 30,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Edits"
    },
    "answers": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Answer"
          },
          "maxItems": 30,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answers"
    }
  },
  "required": [
    "expected_revision"
  ],
  "title": "PatchRequirement",
  "type": "object"
}