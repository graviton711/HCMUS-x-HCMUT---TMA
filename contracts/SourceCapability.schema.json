{
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Source Id",
      "type": "string"
    },
    "supplier_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Supplier Id",
      "type": "string"
    },
    "approved_domains": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Approved Domains",
      "type": "array"
    },
    "access_status": {
      "enum": [
        "approved",
        "blocked",
        "unchecked"
      ],
      "title": "Access Status",
      "type": "string"
    },
    "checked_at": {
      "title": "Checked At",
      "type": "string"
    },
    "modes": {
      "items": {
        "enum": [
          "discover",
          "compare_urls"
        ],
        "type": "string"
      },
      "title": "Modes",
      "type": "array"
    },
    "searchable_fields": {
      "items": {
        "type": "string"
      },
      "title": "Searchable Fields",
      "type": "array"
    },
    "returned_fields": {
      "items": {
        "type": "string"
      },
      "title": "Returned Fields",
      "type": "array"
    },
    "pushdown_semantics": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Pushdown Semantics",
      "type": "object"
    },
    "limits": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Limits",
      "type": "object"
    },
    "freshness_seconds": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Freshness Seconds",
      "type": "object"
    }
  },
  "required": [
    "source_id",
    "supplier_id",
    "approved_domains",
    "access_status",
    "checked_at",
    "modes"
  ],
  "title": "SourceCapability",
  "type": "object"
}