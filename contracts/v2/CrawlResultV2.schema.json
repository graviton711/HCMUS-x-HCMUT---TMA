        "field": {
          "enum": [
            "adults",
            "children_count",
            "rooming",
            "unresolved"
          ],
          "title": "Field",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "field",
        "value"
      ],
      "title": "Applicability",
      "type": "object"
    },
    "CatalogRecordRef": {
      "additionalProperties": false,
      "properties": {
        "table": {
          "enum": [
            "tours",
            "offers"
          ],
          "title": "Table",
          "type": "string"
        },
        "record_key": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Record Key",
          "type": "string"
        },
        "field": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Field",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "table",
        "record_key",
        "field",
        "content_hash"
      ],
      "title": "CatalogRecordRef",
      "type": "object"
    },
    "CatalogValidation": {
      "additionalProperties": false,
      "properties": {
        "policy_version": {
