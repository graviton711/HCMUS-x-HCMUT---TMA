{
  "$defs": {
    "ConversationContext": {
      "additionalProperties": false,
      "properties": {
        "requirement_revision": {
          "minimum": 0,
          "title": "Requirement Revision",
          "type": "integer"
        },
        "proposal_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposal Id"
        },
        "proposal_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposal Version"
        },
        "comparison_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparison Id"
        },
        "result_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Revision"
        },
        "offer_snapshot_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Offer Snapshot Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "requirement_revision"
      ],
      "title": "ConversationContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "text": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "client_message_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Client Message Id",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/ConversationContext"
    }
  },
  "required": [
    "text",
    "client_message_id",
    "context"
  ],
  "title": "ConversationMessage",
  "type": "object"
}