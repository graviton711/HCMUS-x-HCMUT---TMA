{
  "additionalProperties": false,
  "properties": {
    "policy_version": {
      "const": "catalog-validation-v1",
      "default": "catalog-validation-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "source_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Source Id",
      "type": "string"
    },
    "checks": {
      "items": {
        "enum": [
          "schema",
          "record_binding",
          "source_url",
          "timestamp",
          "normalization"
        ],
        "type": "string"
      },
      "title": "Checks",
      "type": "array"
    }
  },
  "required": [
    "source_id",
    "checks"
  ],
  "title": "CatalogValidation",
  "type": "object"
}