{
  "$defs": {
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Candidate Id",
          "type": "string"
        },
        "condition_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Condition Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "matched",
            "not_matched",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 4,
          "title": "Citations",
          "type": "array"
        },
        "tour_snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Tour Snapshot Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "usable_for_ranking": {
          "title": "Usable For Ranking",
          "type": "boolean"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "condition_id",
        "status",
        "citations",
        "tour_snapshot_id",
        "evidence_ids",
        "usable_for_ranking",
        "reason_code"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "excerpt_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Excerpt Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "excerpt_id",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "state": {
      "enum": [
        "completed",
        "partial",
        "skipped"
      ],
      "title": "State",
      "type": "string"
    },
    "policy_version": {
      "default": "semantic-assessment-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "fingerprint": {
      "title": "Fingerprint",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/Assessment"
      },
      "maxItems": 100,
      "title": "Items",
      "type": "array"
    },
    "requested_pairs": {
      "default": 0,
      "title": "Requested Pairs",
      "type": "integer"
    },
    "assessed_pairs": {
      "default": 0,
      "title": "Assessed Pairs",
      "type": "integer"
    },
    "limited": {
      "default": false,
      "title": "Limited",
      "type": "boolean"
    },
    "reason_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    },
    "repair_used": {
      "default": false,
      "title": "Repair Used",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "state",
    "fingerprint"
  ],
  "title": "SemanticReport",
  "type": "object"
}