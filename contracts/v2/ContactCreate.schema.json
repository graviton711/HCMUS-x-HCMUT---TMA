{
  "$defs": {
    "ContactContext": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "comparison_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparison Id"
        }
      },
      "title": "ContactContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "category": {
      "pattern": "^(feedback|data_issue|support)$",
      "title": "Category",
      "type": "string"
    },
    "message": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "reply_to": {
      "anyOf": [
        {
          "maxLength": 254,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reply To"
    },
    "comparison_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comparison Id"
    },
    "client_submission_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Client Submission Id"
    },
    "context": {
      "$ref": "#/$defs/ContactContext"
    }
  },
  "required": [
    "category",
    "message"
  ],
  "title": "ContactCreate",
  "type": "object"
}