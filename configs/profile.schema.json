{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlai.local/schemas/profile.schema.json",
  "title": "Tour source profile",
  "description": "Declarative per-source config. Engine never branches on source names.",
  "type": "object",
  "required": ["origin", "flows"],
  "properties": {
    "version": {"type": "integer", "description": "Survey iteration, stamped by the harness"},
    "surveyed_at": {"type": "string", "description": "Vietnam local ISO time of the last gated survey"},
    "sample_tours": {"type": "array", "items": {"type": "string"},
                     "description": "Dev + holdout tour URLs this version was verified on"},
    "origin": {"type": "string", "description": "Apex domain, e.g. travel.com.vn"},
    "flows": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Subset of: static, browser, combo_api_browser"
    },
    "sitemaps": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "tour_url_patterns": {"type": "array", "items": {"type": "string"}},
    "discovery": {
      "type": "object",
      "properties": {
        "method": {"type": "string", "enum": ["sitemap", "search_pages"]},
        "entry": {"type": "string", "format": "uri"},
        "page_param": {"type": "string"},
        "per_page_param": {"type": "string"},
        "per_page": {"type": "integer"},
        "max_pages": {"type": "integer"},
        "strip_query": {"type": "boolean"},
        "keep_query": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "schedule_markers": {
      "type": "object",
      "properties": {
        "heading": {"type": "string"},
        "month_pattern": {"type": "string"},
        "date_pattern": {"type": "string"}
      },
      "additionalProperties": false
    },
    "section_anchors": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "section_heading_keywords": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "section_heading_fallback": {"type": "array"},
    "notes_key_pattern": {"type": "string"},
    "junk_presentation_keys": {"type": "array", "items": {"type": "string"}},
    "keep_patterns": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
