{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlai.local/schemas/settings.schema.json",
  "title": "Tour crawler global settings",
  "type": "object",
  "properties": {
    "fetch": {
      "type": "object",
      "properties": {
        "timeout_s": {"type": "number"},
        "max_bytes": {"type": "integer"},
        "delay_s": {"type": "number"},
        "user_agent": {"type": "string"},
        "retries": {"type": "integer"},
        "retry_backoff_s": {"type": "number"},
        "dns_ttl_s": {"type": "number"}
      },
      "additionalProperties": true
    },
    "browser": {
      "type": "object",
      "properties": {
        "timeout_ms": {"type": "integer"},
        "max_tabs": {"type": "integer"},
        "max_rows_per_tab": {"type": "integer"},
        "wait_response_ms": {"type": "integer"},
        "tab_growth_wait_ms": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "logging": {
      "type": "object",
      "properties": {"level": {"type": "string"}},
      "additionalProperties": true
    },
    "batch": {
      "type": "object",
      "properties": {
        "max_consecutive_failures": {"type": "integer"},
        "delay_s": {"type": "number"},
        "workers": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "sitemap": {
      "type": "object",
      "properties": {
        "attempts": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "audit": {
      "type": "object",
      "properties": {
        "min_evidence": {"type": "number"}
      },
      "additionalProperties": true
    },
    "opencode": {
      "type": "object",
      "properties": {
        "model": {"type": "string", "minLength": 1}
      },
      "required": ["model"],
      "additionalProperties": true
    },
    "codex": {
      "type": "object",
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh"]}
      },
      "additionalProperties": true
    },
    "survey": {
      "type": "object",
      "properties": {
        "variant": {"type": "string"},
        "timeout_min": {"type": "integer"},
        "prefetch_timeout_s": {"type": "number"},
        "max_body_bytes": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "properties": {"dir": {"type": "string"}},
      "additionalProperties": true
    },
    "clean": {
      "type": "object",
      "properties": {
        "min_visible_chars": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "quality": {
      "type": "object",
      "properties": {
        "min_tours_ratio": {"type": "number"},
        "max_price_shift": {"type": "number"},
        "min_fill_rate": {"type": "number"},
        "fill_fields": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "backend": {
      "type": "object",
      "properties": {
        "data_provider": {"type": "string"},
        "database_url": {"type": "string"},
        "cors_origins": {"type": "array", "items": {"type": "string"}},
        "cors_origin_regex": {"type": "string"},
        "api": {
          "type": "object",
          "properties": {
            "host": {"type": "string"},
            "port": {"type": "integer"},
            "candidate_default": {"type": "integer"},
            "candidate_min": {"type": "integer"},
            "candidate_max": {"type": "integer"},
            "session_ttl_seconds": {"type": "integer", "minimum": 60}
          },
          "additionalProperties": true
        },
        "data": {
          "type": "object",
          "properties": {
            "scan_limit": {"type": "integer"},
            "providers_limit": {"type": "integer"},
            "connect_timeout_s": {"type": "integer"}
          },
          "additionalProperties": true
        },
        "decide": {
          "type": "object",
          "properties": {
            "quote_max_sentences": {"type": "integer"},
            "risk_words": {"type": "array", "items": {"type": "string"}},
            "analysis_chars": {"type": "integer"},
            "analysis_items": {"type": "integer"},
            "top_n": {"type": "integer"},
            "near_miss_max_fails": {"type": "integer"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "required": ["opencode"],
  "additionalProperties": true
}
