{
  "name": "di-cung-frontend",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.ts --host 127.0.0.1",
    "build": "tsc -b config/tsconfig.json && vite build --config config/vite.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --config config/vite.config.ts",
    "test:e2e": "playwright test --config=config/playwright.config.ts",
    "lint": "eslint . --config config/eslint.config.js --max-warnings 0",
    "typecheck": "tsc -b config/tsconfig.json",
    "format": "prettier --config config/.prettierrc.json --ignore-path config/.prettierignore --write .",
    "format:check": "prettier --config config/.prettierrc.json --ignore-path config/.prettierignore --check ."
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
