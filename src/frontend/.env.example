# Public API origin. Blank uses the Vite proxy in development.
# On Vercel services keep it blank: the browser calls same-origin and the
# root vercel.json rewrites API paths to the backend service.
VITE_API_BASE_URL=
# Optional separate auth adapter origin; blank uses VITE_API_BASE_URL.
# Google availability comes from GET /auth/config and Supabase provider settings.
VITE_AUTH_BASE_URL=
