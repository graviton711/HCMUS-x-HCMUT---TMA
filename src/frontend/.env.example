# Public frontend configuration only; keep service/OAuth secrets on the backend.
# Backend origin without /v2; leave empty to use the development proxy.
VITE_API_BASE_URL=
# Optional identity adapter; proposed endpoints are in app/AUTH-ADAPTER.md.
VITE_AUTH_BASE_URL=
# Enable only after the identity adapter and Google OAuth are ready.
VITE_AUTH_GOOGLE_ENABLED=false
