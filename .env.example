SUPABASE_TOUR_DB_URL=
LOG_FILE=.local/logs/backend.log
# Local chat provider. The gateway and model have these defaults.
AGENT_PROVIDER=codex
CODEX_SERVER_URL=http://127.0.0.1:4099
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=medium
CODEX_BINARY=codex
# Legacy Render chat provider; only set when AGENT_PROVIDER=opencode.
OPENCODE_SERVER_URL=
OPENCODE_SERVER_PASSWORD=
OPENCODE_BINARY=opencode
OPENCODE_AGENT=travel-consultant
AGENT_MAX_MESSAGE_CHARS=8000
