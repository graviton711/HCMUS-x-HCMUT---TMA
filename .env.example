# Local settings: backend loads .env automatically (tests ignore it; never commit secrets).
# Every variable below is read by the current code; nothing else is needed.

# Session database (default: sqlite:///data/backend.db)
# Local dev/test: sqlite:///data/backend.db (or :memory:)
# Shared preview: postgres://... on the Supabase project, after applying
# migrations/004_runtime_store.sql (uv run python -c "from ingest.pipeline import migrate_db; migrate_db()")
DATABASE_URL=sqlite:///data/backend.db

# Catalog: fixture (dev, no credentials) or supabase (live, read-only)
DATA_PROVIDER=fixture
# Max tours per comparison (default: 20)
# CANDIDATE_LIMIT=20

# Supabase catalog, read-only via psycopg (also used by ingest publish).
# Only DB_URL is read; TOUR_URL/PUBLISHABLE_KEY are legacy and ignored.
# SUPABASE_TOUR_DB_URL=postgresql://...
# SUPABASE_SCAN_LIMIT=1000

# Real LLM parsing (optional; without it text falls back to keywords).
# Without a key the keyword fallback matches catalog destinations.
# NVIDIA_NIM_API=
# Model/timeout (defaults shown; override only to change them)
# NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
# NIM_TIMEOUT_SECONDS=45

# CORS allowlist for the deployed preview frontend (JSON list / regex string).
# Dev defaults live in configs/settings.yaml; set these on the backend host.
# CORS_ORIGINS=["https://your-app.vercel.app"]
# CORS_ORIGIN_REGEX=https://[a-z0-9-]+\.vercel\.app

# Logging (default: INFO)
# LOG_LEVEL=INFO
