# Keep the existing NVIDIA credentials in root .env.
NVIDIA_NIM_API=
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
NIM_REASONING=none
NIM_TIMEOUT_SECONDS=90
NIM_MAX_TOKENS=4096
# Semantic assessment runs after hard filtering; shares the existing NIM credentials.
SEMANTIC_ASSESSMENT_ENABLED=true
SEMANTIC_TIMEOUT_SECONDS=45
SEMANTIC_MAX_CANDIDATES=12
SEMANTIC_MAX_PAIRS=24
SEMANTIC_EXCERPT_CHARS=6000
SEMANTIC_MAX_INPUT_CHARS=60000
DATABASE_URL=sqlite:///data/backend.db
DATA_PROVIDER=fixture
JOB_TIMEOUT_SECONDS=180
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
SESSION_TTL_HOURS=24
RETENTION_DAYS=7
# To connect the crawler after its contract is validated:
# DATA_PROVIDER=http
# CRAWLER_URL=http://127.0.0.1:9000/crawl
# CRAWLER_REGISTRY_PATH=examples/source-registry.json
# CRAWLER_API_KEY=

# To read the existing Supabase tour catalog (v2 only, no remote writes):
# DATA_PROVIDER=supabase
# SUPABASE_TOUR_DB_URL=
# SUPABASE_TOUR_URL=
# SUPABASE_TOUR_PUBLISHABLE_KEY=
# SUPABASE_TOUR_CONNECT_TIMEOUT_SECONDS=8
# SUPABASE_TOUR_QUERY_TIMEOUT_SECONDS=15
# SUPABASE_TOUR_POOL_SIZE=2
# SUPABASE_TOUR_SCAN_LIMIT=1000
# SUPABASE_TOUR_MAX_OFFERS=1000
